# systemd unit for the API. Copy to /etc/systemd/system/mofi-backend.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mofi-backend
# Logs:  sudo journalctl -u mofi-backend -f
[Unit]
Description=MoFi Life API
After=network.target

[Service]
User=mofi
Group=mofi
WorkingDirectory=/var/www/mofi/backend
Environment="PATH=/var/www/mofi/backend/venv/bin"
# ONE worker only: the daily payout and recovery jobs run inside this process and must not run twice, and a few safety locks live in memory
ExecStart=/var/www/mofi/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
