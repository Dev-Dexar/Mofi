# Copy to .env. Everything here ends up in the browser, so only public values.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=        # the anon key, never the service role key
VITE_TURNSTILE_SITE_KEY=       # Cloudflare Turnstile site key. Leave empty ONLY if CAPTCHA is also off in Supabase (see docs/02)
VITE_SUPPORT_EMAIL=            # shown in the Terms and Privacy pages as the contact address
