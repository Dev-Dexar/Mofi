# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # service role key: server only, never in the frontend

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=        # signs webhooks; without it every webhook is refused
NOWPAYMENTS_EMAIL=             # payouts log in with the dashboard account
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_2FA_SECRET=        # lets payouts verify themselves
NOWPAYMENTS_SANDBOX=false      # true: use the NOWPayments sandbox (test account and keys, no real money)

APP_BASE_URL=http://localhost:5173
API_PUBLIC_URL=                # this backend's public URL, used for gateway webhooks (locally: a tunnel such as cloudflared)
CORS_ORIGINS=                  # extra browser origins, comma separated (APP_BASE_URL and localhost:5173 are always allowed)
ENABLE_DOCS=false              # true shows /docs and /openapi.json
TRUST_PROXY_HEADERS=false      # true only behind a reverse proxy you control
RATE_LIMIT_STORAGE_URI=        # e.g. redis://host:6379 when you run more than one instance
# Withdrawal costs (all paid by the user). The network fee itself is NOWPayments' live estimate; these only shape it.
WITHDRAW_CONVERSION_FEE_PCT=   # NOWPayments' USDT->coin conversion fee in percent (from their dashboard). Empty = only USDT withdrawals
WITHDRAW_FEE_BUFFER_PCT=10     # headroom over the live network-fee estimate, in percent
WITHDRAW_MAX_SLIPPAGE_PCT=3    # a conversion this far short of the quote waits for an admin instead of paying
SETTLEMENT_COIN=usdtbsc        # the coin deposits settle in (the Primary balance on NOWPayments)
PORT=8000
